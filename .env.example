DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/celibery?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/celibery?schema=public"
AUTH_SECRET="replace-with-a-long-random-value"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Order confirmation emails — checkout still succeeds without this, the email is just
# not sent. Free Resend account: sign up, copy the API key. EMAIL_FROM defaults to
# Resend's pre-verified sandbox sender so this works before verifying a custom domain.
RESEND_API_KEY=""
EMAIL_FROM="CELIBERY <onboarding@resend.dev>"
# Card/Apple Pay checkout — with PAYMENT_PROVIDER="mock" (default), checkout still
# works end to end but never actually charges anyone. To go live: sign up at
# moyasar.com, grab the test (or live) keys from the dashboard, set the three
# values below, and set PAYMENT_PROVIDER="moyasar". MOYASAR_SECRET_KEY stays
# server-only; NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY is safe in the browser (that's
# what Moyasar's own hosted card form uses to talk to their API directly — card
# numbers never touch this server). MOYASAR_WEBHOOK_SECRET is the shared secret
# you set when adding a webhook pointed at /api/payments/moyasar/webhook in the
# Moyasar dashboard — it's the durable fallback if a customer closes the tab
# right after paying, before the redirect back to this site completes.
PAYMENT_PROVIDER="mock"
MOYASAR_SECRET_KEY=""
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=""
MOYASAR_WEBHOOK_SECRET=""
SHIPPING_PROVIDER="mock"
EMAIL_PROVIDER="mock"
IMAGE_PROVIDER="cloudinary"

# CELIBERY AI chatbot — the app works fully without any of these (deterministic mode).
# AI_PROVIDER unset or "fallback": rule-based, always available, no external calls.
# AI_PROVIDER="ollama": free local dev model via a running Ollama instance.
# AI_PROVIDER="cloud": generic OpenAI-chat-completions-compatible provider (needs AI_API_KEY).
AI_PROVIDER=""
AI_API_KEY=""
AI_MODEL=""
AI_BASE_URL=""
OLLAMA_BASE_URL="http://localhost:11434"
NEXT_PUBLIC_CHATBOT_ENABLED="true"
CHAT_MAX_MESSAGES="10"
CHAT_RATE_LIMIT="20"
SUPPORT_EMAIL="support@celibery.sa"
NEXT_PUBLIC_SUPPORT_EMAIL="support@celibery.sa"
SUPPORT_WHATSAPP=""
